{
  "name": "voxmire",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "dev": "corepack pnpm --filter @voxmire/desktop dev",
    "cli": "corepack pnpm --filter @voxmire/cli cli",
    "mcp": "corepack pnpm --filter @voxmire/mcp mcp",
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm exec vitest run --exclude \"whisper-binaries/**\"",
    "resources:check": "node scripts/check-resources.mjs",
    "runtimes:download": "node scripts/whisper-runtime-tool.mjs download",
    "runtimes:prepare": "node scripts/whisper-runtime-tool.mjs prepare",
    "runtimes:promote": "node scripts/whisper-runtime-tool.mjs promote",
    "runtimes:upload": "node scripts/whisper-runtime-tool.mjs upload",
    "runtimes": "node scripts/whisper-runtime-tool.mjs menu",
    "runtimes:upload:r2": "node scripts/whisper-runtime-tool.mjs upload --target r2",
    "models:download": "node scripts/download-whisper-models.mjs",
    "models:download:all": "node scripts/download-whisper-models.mjs --all",
    "app:runtimes:check": "node scripts/check-app-runtime-bundle.mjs",
    "app:models:check": "node scripts/check-app-model-bundle.mjs",
    "desktop:package": "node scripts/download-whisper-models.mjs && corepack pnpm --filter @voxmire/desktop package:win"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.5"
  }
}
