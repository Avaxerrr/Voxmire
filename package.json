{
    "name":  "voxmire",
    "version":  "0.0.0",
    "private":  true,
    "packageManager":  "pnpm@9.15.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "corepack pnpm --filter @voxmire/desktop dev",
                    "build":  "corepack pnpm -r build",
                    "typecheck":  "corepack pnpm -r typecheck",
                    "lint":  "corepack pnpm -r lint",
                    "test":  "corepack pnpm exec vitest run",
                    "resources:check":  "node scripts/check-resources.mjs"
                },
    "devDependencies":  {
                            "@types/node":  "^24.10.1",
                            "typescript":  "^5.8.0",
                            "vitest":  "^4.1.5"
                        }
}
